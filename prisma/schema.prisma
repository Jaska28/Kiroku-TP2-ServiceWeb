// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

// --- MODELES ---
model User {
  userId    String  @id @default(uuid()) @db.Uuid
  clerkId   String  @unique
  username  String  @unique
  firstName String?
  lastName  String?
  role      Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaLists MediaList[]
  reviews    Review[]
  orders     Order[]
}

model Media {
  mediaId   String @id @default(uuid()) @db.Uuid
  anilistId Int    @unique
  idMal     Int? // Id from MyAnimeList not necessarily present
  title     String
  avgScore  Float? // score calculated by our own app

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaListItems MediaListItem[]
  reviews        Review[]
  products       Product[]
}

model MediaList {
  mediaListId String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  desc        String?
  isPublic    Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade) // if user is deleted his list are deleted as well

  mediaListItems MediaListItem[]

  @@unique([userId, name]) // prevents duplicate list per users
}

model MediaListItem {
  mediaListItemId String @id @default(uuid()) @db.Uuid
  mediaListId     String @db.Uuid
  mediaId         String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaList MediaList @relation(fields: [mediaListId], references: [mediaListId], onDelete: Cascade) // if list is deleted delete its items
  media     Media     @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade) // if the media is deleted delete any medialistitem that references it

  @@unique([mediaListId, mediaId]) // prevents duplicates media in lists
}

model Review {
  reviewId String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  mediaId  String  @db.Uuid
  rating   Float // in between 0 and 10
  comments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [userId], onDelete: Cascade) // if the user is deleted delete all his reviews
  media Media @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade) // if the media is deleted delete all related reviews

  @@unique([userId, mediaId]) // only one review per user per media
}

enum EditionType {
  MANGA_VOLUME
  ANIME_EPISODE
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

model Product {
  productId     String      @id @default(uuid()) @db.Uuid
  mediaId       String      @db.Uuid
  name          String
  editionType   EditionType
  editionNumber Int
  priceCents    Int         @default(499)

  media      Media       @relation(fields: [mediaId], references: [mediaId], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([mediaId, editionType, editionNumber])
}

model Order {
  orderId                 String      @id @default(uuid()) @db.Uuid
  userId                  String      @db.Uuid
  status                  OrderStatus @default(PENDING)
  currency                String      @default("cad") @db.Char(3)
  subtotalCents           Int
  gstCents                Int
  qstCents                Int
  totalCents              Int
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  createdAt               DateTime    @default(now())
  paidAt                  DateTime?

  user   User        @relation(fields: [userId], references: [userId], onDelete: Restrict)
  items  OrderItem[]
  refund Refund?

  @@index([userId, status])
}

model OrderItem {
  orderItemId    String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  productId      String @db.Uuid
  productName    String
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

model Refund {
  refundId       String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique @db.Uuid
  stripeRefundId String   @unique
  amountCents    Int
  refundedAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
